# Puerto de ejecución del servidor
PORT=5000

# Cadena de conexión a MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster0.5miiieo.mongodb.net/SenaMongoDB?retryWrites=true&w=majority

# Genera una clave propia de 32+ caracteres; no dejes este valor vacío
JWT_SECRET=

# Entorno de ejecución
NODE_ENV=development

# Origen permitido del frontend (pueden separarse varios por coma)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173

# URL pública del frontend usada en enlaces de recuperación
FRONTEND_URL=http://localhost:5173

# Correo SMTP para recuperar contraseñas; usa credenciales SMTP del proveedor
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Solo para el seed local de demostración; no usar en producción
DEMO_INITIAL_PASSWORD=

# Permite la importación temporal de datos sintéticos; nunca habilitar en producción
ENABLE_TEST_DATA_IMPORT=false
